# Локальная разработка: скопируй в .env.
# На хостинге добавь эти значения в раздел Environment Variables / Variables.
BOT_TOKEN=
API_ID=
API_HASH=

# Нужен для работы раздела «Чат с ИИ».
TOKENPLAN_API_KEY=
# Необязательная переменная: если не задана, используется адрес ниже.
TOKENPLAN_BASE_URL=https://tokenplan.lat/v1/chat/completions

# Укажи путь на постоянном диске/volume хостинга, чтобы история не терялась
# при перезапуске или пересоздании контейнера.
AI_CHAT_HISTORY_FILE=data/ai_chats.json

# Crypto Pay: оставь пустым до настройки платежей в приложении Crypto Pay.
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_API_URL=https://pay.crypt.bot/api
PREMIUM_PAYMENTS_FILE=data/premium_payments.json
MATH_CAPTCHA_FILE=data/math_captcha_verified.json
